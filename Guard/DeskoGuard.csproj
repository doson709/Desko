<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tiny native watchdog (Native AOT): waits for Desko.exe and, if it died without cleaning up,
       puts every fenced item back on the desktop. ~1-2 MB of memory instead of a second .NET runtime. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DeskoGuard</AssemblyName>
    <RootNamespace>DeskoGuard</RootNamespace>
    <ApplicationIcon>..\assets\desko.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
