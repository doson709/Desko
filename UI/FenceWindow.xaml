<Window x:Class="Desko.UI.FenceWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowActivated="False" Title="Desko"
        FontFamily="Segoe UI" FontSize="12" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- The part of a fence above the desktop icons. Its background, tint and highlights are painted below
         the icons by a FenceBackdrop; this window only draws the title, tabs, scroll bar and (for folder portals)
         the items. Where it is fully transparent the mouse goes through to the desktop icons, so the title bar and
         the edge band are filled with an invisible #01000000 to keep them clickable. Colours below are replaced
         at runtime from the Windows theme (light/dark, accent colour) by FenceWindow.ApplyAppearance. -->
    <Window.Resources>
        <SolidColorBrush x:Key="FenceTextBrush" Color="White"/>
        <SolidColorBrush x:Key="FenceSubtleTextBrush" Color="#AAFFFFFF"/>
        <sys:Double x:Key="FenceShadowOpacity">0.9</sys:Double>
        <!-- Item layout, set from Explorer's own by FenceWindow.UpdateCellSize. -->
        <Thickness x:Key="IconPictureMargin">0,7,0,3</Thickness>
        <FontFamily x:Key="IconFont">Segoe UI</FontFamily>
        <sys:Double x:Key="IconFontSize">12</sys:Double>
        <sys:Double x:Key="IconLineHeight">16</sys:Double>
        <sys:Double x:Key="IconLabelHeight">32</sys:Double>
        <SolidColorBrush x:Key="HoverBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4CA3FF"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#554CA3FF"/>
        <SolidColorBrush x:Key="SelectionBorderBrush" Color="#AA4CA3FF"/>
        <SolidColorBrush x:Key="DropTargetBrush" Color="#774CA3FF"/>
        <SolidColorBrush x:Key="DropGlowBrush" Color="#2A4CA3FF"/>
        <SolidColorBrush x:Key="MarqueeFillBrush" Color="#334CA3FF"/>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Margin" Value="0,2,2,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="{DynamicResource FenceSubtleTextBrush}" Opacity="0.6"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One item is exactly one cell of the desktop's icon grid (the panel sizes it), laid out like Explorer's:
             the icon centred 2px below the top, the label under it. Folder portals and normal fences line up. -->
        <Style x:Key="FenceItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <!-- Hover fades in and out; selection and drop-target states sit on top of it. -->
                            <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="4" Margin="3,0,3,3" Opacity="0"/>
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="4" Margin="3,0,3,3"/>
                            <ContentPresenter/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DropTargetBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A stand-in drawn while a fence is dragged or resized (see FenceWindow.BeginLift): it looks like the
             desktop's own icon (white label, dark shadow) and is cheap enough to appear in the first frame, so no
             fade-in, no rename box and a plain offset shadow instead of a blur effect. -->
        <DataTemplate x:Key="ProxyTemplate">
            <StackPanel Width="{Binding ItemWidth}" HorizontalAlignment="Center">
                <Image Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}"
                       Margin="{DynamicResource IconPictureMargin}" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Grid TextElement.FontFamily="{DynamicResource IconFont}" TextElement.FontSize="{DynamicResource IconFontSize}">
                    <TextBlock Text="{Binding Name}" Foreground="#A0000000" Margin="1,1,-1,-1" TextAlignment="Center"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight"
                               LineHeight="{DynamicResource IconLineHeight}" MaxHeight="{DynamicResource IconLabelHeight}"/>
                    <TextBlock Text="{Binding Name}" Foreground="White" TextAlignment="Center"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight"
                               LineHeight="{DynamicResource IconLineHeight}" MaxHeight="{DynamicResource IconLabelHeight}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="8" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Background="#01000000" CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MouseEnter="TitleBar_MouseEnter">
                <Grid>
                    <TextBlock x:Name="PortalGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;"
                               Foreground="{DynamicResource FenceSubtleTextBrush}" FontSize="12" Margin="9,0,0,0" IsHitTestVisible="False"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="TitleText" Foreground="{DynamicResource FenceTextBrush}" FontSize="13" Margin="28,0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="{DynamicResource FenceShadowOpacity}" Color="Black"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" Margin="26,0"
                                HorizontalAlignment="Center" Visibility="Collapsed"/>
                    <TextBox x:Name="TitleEdit" Visibility="Collapsed" Margin="26,3"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             Background="#E0202020" Foreground="White" CaretBrush="White" BorderBrush="{DynamicResource AccentBrush}"
                             KeyDown="TitleEdit_KeyDown" LostKeyboardFocus="TitleEdit_LostKeyboardFocus"/>
                    <!-- Back, while browsing a subfolder of a folder portal. -->
                    <Border x:Name="BackButton" Width="26" HorizontalAlignment="Left" Background="Transparent"
                            Cursor="Hand" ToolTip="Quay lại (Backspace)" Visibility="Collapsed"
                            MouseLeftButtonDown="BackButton_MouseLeftButtonDown">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="12"
                                   Foreground="{DynamicResource FenceTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Type-to-filter box: appears as soon as you type in the fence. -->
                    <Border x:Name="SearchPanel" Visibility="Collapsed" Margin="26,4" CornerRadius="4"
                            Background="#E0202020" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="11" Foreground="#CCFFFFFF"
                                       Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox" Margin="24,0,4,0" Background="Transparent" BorderThickness="0"
                                     Foreground="White" CaretBrush="White" VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                     LostKeyboardFocus="SearchBox_LostKeyboardFocus"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="LockGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE72E;"
                               Foreground="{DynamicResource FenceSubtleTextBrush}" FontSize="11" Margin="0,0,9,0" IsHitTestVisible="False"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <ListBox x:Name="Items" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="4"
                     SelectionMode="Extended" ItemContainerStyle="{StaticResource FenceItem}"
                     IsTextSearchEnabled="False"
                     PreviewTextInput="Items_PreviewTextInput"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="Items_PreviewMouseMove"
                     PreviewMouseLeftButtonUp="Items_PreviewMouseLeftButtonUp"
                     KeyDown="Items_KeyDown">
                <ListBox.Resources>
                    <!-- Overlay scrollbar: drawn over the right edge instead of taking width away from the icons,
                         so every fence lays out the same number of columns whether it scrolls or not. -->
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid>
                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                Margin="{TemplateBinding Padding}"
                                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                        <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical"
                                                   HorizontalAlignment="Right"
                                                   Minimum="0"
                                                   Maximum="{TemplateBinding ScrollableHeight}"
                                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Whole cells, centred: the same columns a normal fence of this width shows. -->
                        <WrapPanel HorizontalAlignment="Center"
                                   ItemWidth="{Binding CellWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                   ItemHeight="{Binding CellHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="{Binding ItemWidth}" HorizontalAlignment="Center" ToolTip="{Binding Name}">
                            <!-- Icons fade in as they arrive instead of popping in. -->
                            <Image Source="{Binding Icon, NotifyOnTargetUpdated=True}" Width="{Binding IconSize}" Height="{Binding IconSize}"
                                   Margin="{DynamicResource IconPictureMargin}" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Triggers>
                                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Image.Triggers>
                            </Image>
                            <Grid TextElement.FontFamily="{DynamicResource IconFont}" TextElement.FontSize="{DynamicResource IconFontSize}">
                                <TextBlock x:Name="Label" Text="{Binding Name}" Foreground="{DynamicResource FenceTextBrush}" TextAlignment="Center"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight"
                                           LineHeight="{DynamicResource IconLineHeight}" MaxHeight="{DynamicResource IconLabelHeight}">
                                    <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="{DynamicResource FenceShadowOpacity}" Color="Black"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <!-- In-place rename box, like Explorer's. -->
                                <TextBox x:Name="RenameBox" Visibility="Collapsed" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Center" TextWrapping="Wrap" MaxHeight="64" Padding="1,0"
                                         Background="White" Foreground="Black" BorderBrush="{DynamicResource AccentBrush}"
                                         KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostKeyboardFocus"
                                         IsVisibleChanged="RenameBox_IsVisibleChanged"/>
                            </Grid>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                <Setter TargetName="Label" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="RenameBox" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- While a normal fence is dragged or resized, its icons are drawn here (they move with the window, frame
                 for frame) and the real ones wait off screen; see FenceWindow.BeginLift. -->
            <Canvas x:Name="IconProxy" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed"/>

            <!-- Edge band: keeps the edges of a normal fence clickable for resizing, while the icon area between
                 them lets every click through to the desktop icons. -->
            <Border x:Name="EdgeGrip" Grid.RowSpan="2" BorderThickness="7,0,7,7" BorderBrush="#01000000"
                    CornerRadius="0,0,8,8" IsHitTestVisible="False"/>

            <!-- Scroll bar of a normal fence whose icons do not all fit. -->
            <Canvas x:Name="ScrollLayer" Grid.Row="1" Margin="0,4,2,8" Visibility="Collapsed">
                <Border x:Name="ScrollThumb" Width="6" CornerRadius="3" Canvas.Right="0"
                        Background="{DynamicResource FenceSubtleTextBrush}" Opacity="0.65"
                        MouseLeftButtonDown="ScrollThumb_MouseLeftButtonDown" MouseMove="ScrollThumb_MouseMove"
                        MouseLeftButtonUp="ScrollThumb_MouseLeftButtonUp"/>
            </Canvas>

            <!-- Rubber-band selection rectangle (drawn above the items, never takes the mouse). -->
            <Canvas x:Name="MarqueeLayer" Grid.Row="1" IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle x:Name="Marquee" Visibility="Collapsed" Fill="{DynamicResource MarqueeFillBrush}"
                           Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" RadiusX="2" RadiusY="2"/>
            </Canvas>

            <TextBlock x:Name="EmptyHint" Grid.Row="1" Foreground="{DynamicResource FenceSubtleTextBrush}" Margin="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
